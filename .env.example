# Copy to .env.local and fill in. Never commit .env.local.

# --- Core ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/card_tracker
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=America/Los_Angeles

# --- Auth (Google OAuth; single allowlisted account) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=nick.lahner7@gmail.com

# --- GCP (needed from M5; local dev uses disk storage + LocalQueue) ---
GCP_PROJECT_ID=
GCP_REGION=us-west1
GCS_BUCKET=
TASKS_QUEUE=
TASKS_INVOKER_SA=
TASKS_AUDIENCE=

# --- Providers ---
# fake = no paid calls (default for dev, tests and CI). live = real APIs.
PROVIDERS_MODE=fake
CARDSIGHTAI_API_KEY=
SPORTSCARDSPRO_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=

# --- Tunables (see DESIGN.md §7, §14) ---
PROVIDER_CACHE_TTL_DAYS=8
COMPS_DAILY_THRESHOLD_CENTS=5000
CARDSIGHT_MONTHLY_QUOTA=5000
ANTHROPIC_MONTHLY_BUDGET_CENTS=3000
